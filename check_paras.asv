clc; clear; close all;

%% 1. SYSTEM PARAMETERS
lambda = 633e-9;       % Wavelength (m)
z1 = 1500e-6;          % Plane 1 (m)
z2 = 2000e-6;          % Plane 2 (m)
dz = z2 - z1;

%% 2. SENSOR / SAMPLING PARAMETERS
area = 1000e-6;        % FOV (m)
dx = 500e-9;             % unit: m
N = round(area/dx);
dy = dx;
z_max = N * dx^2 / lambda;

% Define Coordinates
x = linspace(-area/2, area/2, N);
y = linspace(-area/2, area/2, N);
x_um = x * 1e6;
y_um = y * 1e6;

fprintf('====================================\n');
fprintf('       SYSTEM PARAMETERS\n');
fprintf('====================================\n');
fprintf('Wavelength  : %.1f nm\n', lambda*1e9);
fprintf('Grid size   : %d x %d pixels\n', N, N);
fprintf('Pixel pitch : %.4f um\n', dx*1e6);
fprintf('FOV         : %.2f um\n', area*1e6);
fprintf('z1          : %.2f um\n', z1*1e6);
fprintf('z2          : %.2f um\n', z2*1e6);
fprintf('dz          : %.2f um\n', dz*1e6);
fprintf('z_max       : %.2f mm\n', z_max*1e3);

%% 3. CREATE OBJECT (Two Point Objects)

% ===== OBJECT PARAMETERS (UNIT: nm) =====
object_size_nm = 200;       % Diameter / width of each object
center_distance_nm = 400;  % Center-to-center distance

% Object shape: 'circle' or 'square'
object_shape = 'circle';

% Convert physical dimensions to meters
object_size = object_size_nm * 1e-9;
center_distance = center_distance_nm * 1e-9;

% Physical coordinates
[X, Y] = meshgrid(x, y);

% Define object centers (symmetric around origin)
x1 = -center_distance/2;
x2 =  center_distance/2;
y1 = 0;
y2 = 0;

% Initialize transparent background
object = ones(N, N);

% ===== CREATE OBJECT 1 =====
switch lower(object_shape)
    case 'circle'
        mask1 = (X-x1).^2 + (Y-y1).^2 <= (object_size/2)^2;
        mask2 = (X-x2).^2 + (Y-y2).^2 <= (object_size/2)^2;

    case 'square'
        mask1 = abs(X-x1) <= object_size/2 & ...
                abs(Y-y1) <= object_size/2;

        mask2 = abs(X-x2) <= object_size/2 & ...
                abs(Y-y2) <= object_size/2;

    otherwise
        error('Unknown object shape.');
end

% Opaque objects
object(mask1 | mask2) = 0;

% ===== DISPLAY ACTUAL DIMENSIONS =====
fprintf('\n========== OBJECT PARAMETERS ==========\n');
fprintf('Shape              : %s\n', object_shape);
fprintf('Object size        : %.1f nm\n', object_size_nm);
fprintf('Center distance    : %.1f nm\n', center_distance_nm);
fprintf('Edge-to-edge gap   : %.1f nm\n', ...
    center_distance_nm-object_size_nm);
fprintf('Object size (pixel): %.2f pixels\n', object_size/dx);
fprintf('Center distance(px): %.2f pixels\n', center_distance/dx);
fprintf('=======================================\n');


%% 4. TRANSMISSION FUNCTION
% Incident light intensity
I0 = 100;                 % Relative incident intensity
A0 = sqrt(I0);             % Incident field amplitude

% Transmission function
t = A0 * object;

am = abs(object);


%% 5. DISPLAY OBJECT
figure('Name', 'Object Details', 'Color', 'w', 'Position', [100 200, 500, 450]);
imshow(x_um, y_um, object);
title('Binary Object / Transmission Function'); 
xlabel('x (\mum)'); ylabel('y (\mum)');

%% 6. ORIGINAL OBJECT CROSS-SECTION
mid_y = round(N/2)+1; 
profile_obj_am = am(:, mid_y);

figure('Name', 'Ground Truth Cross-Section', 'Color', 'w', 'Position', [150 500, 600, 400]);
plot(y_um, profile_obj_am, 'k', 'LineWidth', 1.5);
grid on; grid minor; 
xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('Amplitude');
title('Object Amplitude Cross-section at center ($y=0$)', 'Interpreter', 'latex');
xlim([-50, 50]); % Zooming into the center 100um

%% 7. HOLOGRAM SIMULATION
prop_z1 = Propagator_BLASM(N, lambda, area, dx, z1);
prop_z2 = Propagator_BLASM(N, lambda, area, dx, z2);

field_z1_true = IFT2Dc(FT2Dc(t) .* prop_z1);
field_z2_true = IFT2Dc(FT2Dc(t) .* prop_z2);

hologram1 = abs(field_z1_true).^2; 
hologram2 = abs(field_z2_true).^2;

amp1_measured = sqrt(hologram1);
amp2_measured = sqrt(hologram2);
figure;
imshow(flipud(rot90(hologram1)), []);
title('simulated hologram / a.u.')
xlabel({'x / px'})
ylabel({'y / px'})
axis on
set(gca,'YDir','normal')
colormap('gray')
colorbar;

%% 8. VISUALIZATION (HOLOGRAMS)
figure('Name', 'Measured Holograms', 'Color', 'w', 'Position', [100 100 1000 400]);
subplot(1,2,1); 
imagesc(x_um, y_um, hologram1); axis image;
title(sprintf('Hologram 1 ($z_1 = %d$ $\\mu$m)', round(z1*1e6)), 'Interpreter', 'latex'); 
xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('$y$ ($\mu$m)', 'Interpreter', 'latex'); colorbar; colormap gray;
subplot(1,2,2); 
imagesc(x_um, y_um, hologram2); axis image;
title(sprintf('Hologram 2 ($z_2 = %d$ $\\mu$m)', round(z2*1e6)), 'Interpreter', 'latex'); 
xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('$y$ ($\mu$m)', 'Interpreter', 'latex'); colorbar; colormap gray;

%% 9. HOLOGRAM CROSS-SECTION
profile_holo1 = hologram1(mid_y, :);
profile_holo2 = hologram2(mid_y, :);

figure('Name', 'Hologram Cross-Sections', 'Color', 'w', 'Position', [150 150 1000 400]);
subplot(1,2,1);
plot(x_um, profile_holo1, 'b', 'LineWidth', 1.2); grid on;
xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('Intensity (a.u.)');
title(sprintf('Hologram 1 Cross-section ($z_1 = %.1f$ $\\mu$m)', z1*1e6), 'Interpreter', 'latex');
subplot(1,2,2);
plot(x_um, profile_holo2, 'r', 'LineWidth', 1.2); grid on;
xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('Intensity (a.u.)');
title(sprintf('Hologram 2 Cross-section ($z_2 = %.1f$ $\\mu$m)', z2*1e6), 'Interpreter', 'latex');

%% 10. PHASE RETRIEVAL (Plane-to-Plane)
Iterations = 300;
prop_dz = Propagator_BLASM(N, lambda, area, dx, dz);
prop_minus_dz = Propagator_BLASM(N, lambda, area, dx, -dz);
prop_minus_z1 = Propagator_BLASM(N, lambda, area, dx, -z1);

u1 = amp1_measured .* exp(1i * zeros(N, N));

fprintf('\nRunning Phase Retrieval loop (%d iterations)...\n', Iterations);
figure('Name', 'Reconstruction Progress', 'Position', [200, 200, 1000, 450], 'Color', 'w');

for iter = 1:Iterations
    u2_sim = IFT2Dc(FT2Dc(u1) .* prop_dz);
    u2 = amp2_measured .* exp(1i * angle(u2_sim)); 
    
    u1_sim = IFT2Dc(FT2Dc(u2) .* prop_minus_dz); 
    u1 = amp1_measured .* exp(1i * angle(u1_sim));
    
    if mod(iter, 10) == 0 || iter == 1 || iter == Iterations
        u_obj_rec = IFT2Dc(FT2Dc(u1) .* prop_minus_z1);
        
        subplot(1,2,1); imagesc(x_um, y_um, abs(u_obj_rec)); axis image; colormap gray;
        title(sprintf('Rec. Amplitude (Iter: %d)', iter)); colorbar;
        xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('$y$ ($\mu$m)', 'Interpreter', 'latex');
        
        subplot(1,2,2); imagesc(x_um, y_um, angle(u_obj_rec)); axis image; colormap gray;
        title(sprintf('Rec. Phase (Iter: %d)', iter)); colorbar;
        xlabel('$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel('$y$ ($\mu$m)', 'Interpreter', 'latex');
        drawnow;
    end
end
fprintf('Reconstruction complete!\n');

%% 11. CROSS-SECTION EVALUATION
amp_rec = abs(u_obj_rec);
fig = figure('Color','w', 'Name','Select Cross-section', 'Position', [300, 300, 800, 600]);
ax = axes(fig);
imagesc(ax, x_um, y_um, amp_rec); axis(ax,'image'); colormap(ax,gray); colorbar(ax);
xlabel(ax,'$x$ ($\mu$m)', 'Interpreter', 'latex'); ylabel(ax,'$y$ ($\mu$m)', 'Interpreter', 'latex');
title(ax,'Draw a line between TWO points to evaluate cross-section');
h = drawline(ax,'Color','r','LineWidth',1.5);
wait(h); 
pos = h.Position;
x_click = pos(:,1)';
y_click = pos(:,2)';
num_points = 500;
x_line = linspace(x_click(1), x_click(2), num_points);
y_line = linspace(y_click(1), y_click(2), num_points);
[X_grid, Y_grid] = meshgrid(x_um, y_um);
profile_rec = interp2(X_grid, Y_grid, amp_rec, x_line, y_line, 'linear');
profile_true = interp2(X_grid, Y_grid, am, x_line, y_line, 'linear'); 
distance = hypot(x_line - x_line(1), y_line - y_line(1));

figure('Color','w');
plot(distance, profile_true, 'Color', '#0072BD', 'LineWidth', 1.5); hold on;
plot(distance, profile_rec, 'Color', '#D95319', 'LineWidth', 1.5, 'LineStyle', '--');
grid on;
xlabel('Distance ($\mu$m)', 'Interpreter', 'latex'); ylabel('Amplitude (a.u.)');
legend('Ground Truth', 'Reconstruction');
title('Amplitude Cross-section Evaluation');

%% =========================================================================
%                               FUNCTIONS
% =========================================================================
function p = Propagator_BLASM(N, lambda, area, dx, z)
    [X, Y] = meshgrid(1:N, 1:N);
    alpha = lambda * (Y - N/2 - 1) / area;
    beta  = lambda * (X - N/2 - 1) / area;
    
    % Tính giới hạn tần số để cắt nhiễu aliasing (Band-Limited ASM)
    limit = 1 / sqrt((2 * abs(z) / (N * dx))^2 + 1);
    mask = (alpha.^2 + beta.^2) <= limit^2;
    
    p = zeros(N, N);
    p(mask) = exp(2 * pi * 1i * z * sqrt(1 - alpha(mask).^2 - beta(mask).^2) / lambda);
end

function out = FT2Dc(in)
    [Nx, Ny] = size(in);
    vx = (-1).^(1:Nx).'; 
    vy = (-1).^(1:Ny);   
    f1 = vx * vy;        
    out = f1 .* fft2(f1 .* in);
end

function out = IFT2Dc(in)
    [Nx, Ny] = size(in);
    vx = (-1).^(1:Nx).'; 
    vy = (-1).^(1:Ny);   
    f1 = vx * vy;        
    out = f1 .* ifft2(f1 .* in);
end