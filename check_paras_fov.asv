clc; clear; close all;
tic

%% 1. SYSTEM PARAMETERS (Cố định)
lambda_0 = 405e-9;          % Wavelength (m)
diffractive_index = 1;
lambda = lambda_0 / diffractive_index;

z1 = 1500e-6;               % Plane 1 (m)
z2 = 2000e-6;               % Plane 2 (m)
dz = z2 - z1;

dx = 100e-9;                % Pixel pitch (m)
dy = dx;
Iterations = 100;           % Số vòng lặp Gerchberg-Saxton

% Object parameters (Cố định kích thước vật lý)
object_width_nm    = 200;   % Width of each slit (nm)
object_length_nm   = 5000;  % Length of each slit (nm)
center_distance_nm = 200 + 200;

object_width    = object_width_nm    * 1e-9;
object_length   = object_length_nm   * 1e-9;
center_distance = center_distance_nm * 1e-9;

% In thông số hệ thống & vật thể cố định ban đầu
fprintf('================ FIXED SYSTEM & OBJECT PARAMETERS ================\n');
fprintf('Wavelength (lambda) : %.1f nm (n = %.2f)\n', lambda*1e9, diffractive_index);
fprintf('Pixel pitch (dx)    : %.4f um (%.1f nm)\n', dx*1e6, dx*1e9);
fprintf('Plane z1 / z2 / dz  : %.1f um / %.1f um / %.1f um\n', z1*1e6, z2*1e6, dz*1e6);
fprintf('GS Iterations       : %d\n', Iterations);
fprintf('Object Shape        : Two parallel slits (%.1f nm x %.1f nm)\n', object_width_nm, object_length_nm);
fprintf('Center-to-Center    : %.1f nm (Edge-to-edge gap: %.1f nm)\n', ...
        center_distance_nm, center_distance_nm - object_width_nm);
fprintf('Object Size (px)    : %.2f x %.2f pixels\n', object_width/dx, object_length/dx);
fprintf('==================================================================\n');

%% 2. DANH SÁCH FOV CẦN KHẢO SÁT
FOV_list_um = [100, 200, 300, 500]; 
num_FOV = length(FOV_list_um);

% Mảng lưu trữ thông số để xuất bảng tổng kết cuối cùng
summary_data = zeros(num_FOV, 9);

% Tạo Figure tổng hợp để so sánh kết quả của tất cả FOV
fig_compare = figure('Name', 'Comparison Across Different FOVs', ...
                     'Color', 'w', 'Position', [80, 80, 1250, 820]);

%% 3. VÒNG LẶP CHẠY TỰ ĐỘNG QUA TỪNG GIÁ TRỊ FOV
for k = 1:num_FOV
    area = FOV_list_um(k) * 1e-6;   % Chuyển đổi sang mét
    N = round(area / dx);
    
    % --- Tính toán thông số phân giải & khẩu độ số (NA) ---
    z_max = N * dx^2 / lambda;      % Khoảng cách chuyển tiếp Fresnel/ASM
    NA_Nyq = lambda / (2 * dx);
    if NA_Nyq < 1
        z_crit = (area / 2) * sqrt(1 - NA_Nyq^2) / NA_Nyq;
    else
        z_crit = 0;                 % Chế độ sóng suy giảm (dx <= lambda/2)
    end
    
    NA_geo_z1 = 1 / sqrt(1 + (2 * z1 / area)^2);
    NA_geo_z2 = 1 / sqrt(1 + (2 * z2 / area)^2);
    
    NA_eff_z1 = min([diffractive_index, NA_geo_z1, NA_Nyq]);
    NA_eff_z2 = min([diffractive_index, NA_geo_z2, NA_Nyq]);
    
    R_z1 = lambda / (2 * NA_eff_z1);
    R_z2 = lambda / (2 * NA_eff_z2);
    
    % --- In đầy đủ thông số mô phỏng của FOV hiện tại ---
    fprintf('\n------------------------------------------------------------------\n');
    fprintf('>>> SIMULATION %d/%d | FOV = %d um\n', k, num_FOV, FOV_list_um(k));
    fprintf('------------------------------------------------------------------\n');
    fprintf('Grid size        : %d x %d pixels\n', N, N);
    fprintf('z_max (Aliasing) : %.2f mm\n', z_max*1e3);
    fprintf('z_crit (R = dx)  : %.2f um\n', z_crit*1e6);
    fprintf('NA_Nyq           : %.5f\n', NA_Nyq);
    fprintf('NA at z1         : %.5f (Effective: %.5f)\n', NA_geo_z1, NA_eff_z1);
    fprintf('NA at z2         : %.5f (Effective: %.5f)\n', NA_geo_z2, NA_eff_z2);
    fprintf('Resolution at z1 : %.2f nm\n', R_z1*1e9);
    fprintf('Resolution at z2 : %.2f nm\n', R_z2*1e9);
    
    % Kiểm tra chế độ giới hạn độ phân giải
    if NA_Nyq < min(NA_geo_z1, NA_geo_z2)
        regime_str = 'Sampling-limited';
        fprintf('[STATUS] %s: R is bounded by pixel pitch (dx = %.1f nm).\n', regime_str, dx*1e9);
    elseif max(z1, z2) > z_crit
        regime_str = 'Aperture-limited';
        fprintf('[STATUS] %s: z1 or z2 > z_crit, R is bounded by FOV (> %.1f nm).\n', regime_str, dx*1e9);
    else
        regime_str = 'Optimal';
    end
    
    % --- Tạo lưới tọa độ ---
    x = (-N/2 : N/2 - 1) * dx;
    y = (-N/2 : N/2 - 1) * dy;
    x_um = x * 1e6;
    y_um = y * 1e6;
    [X, Y] = meshgrid(x, y);
    
    % --- Tạo vật thể (2 khe hẹp) ---
    x1_obj = -center_distance / 2;
    x2_obj =  center_distance / 2;
    
    object = ones(N, N);
    mask1 = abs(X - x1_obj) <= object_width/2 & abs(Y) <= object_length/2;
    mask2 = abs(X - x2_obj) <= object_width/2 & abs(Y) <= object_length/2;
    object(mask1 | mask2) = 0;
    
    u_object = object; % A0 = 1
    am = abs(u_object);
    [~, mid_y] = min(abs(y));
    
    % --- Mô phỏng Hologram tại z1 và z2 ---
    prop_z1 = Propagator_BLASM(N, lambda, dx, z1);
    prop_z2 = Propagator_BLASM(N, lambda, dx, z2);
    
    field_z1_true = IFT2Dc(FT2Dc(u_object) .* prop_z1);
    field_z2_true = IFT2Dc(FT2Dc(u_object) .* prop_z2);
    
    amp1_measured = abs(field_z1_true);
    amp2_measured = abs(field_z2_true);
    
    % --- Thuật toán khôi phục pha Gerchberg-Saxton ---
    prop_dz       = Propagator_BLASM(N, lambda, dx, dz);
    prop_minus_dz = Propagator_BLASM(N, lambda, dx, -dz);
    prop_minus_z1 = Propagator_BLASM(N, lambda, dx, -z1);
    
    u1 = amp1_measured;
    for iter = 1:Iterations
        u2_sim = IFT2Dc(FT2Dc(u1) .* prop_dz);
        u2 = amp2_measured .* exp(1i * angle(u2_sim));
        
        u1_sim = IFT2Dc(FT2Dc(u2) .* prop_minus_dz);
        u1 = amp1_measured .* exp(1i * angle(u1_sim));
    end
    
    % Truyền ngược về mặt phẳng vật thể
    u_obj_rec = IFT2Dc(FT2Dc(u1) .* prop_minus_z1);
    amp_rec = abs(u_obj_rec);
    
    % --- Trích xuất mặt cắt ngang tại y = 0 và tính sai số RMSE ---
    x_roi_um = 5; % Zoom vùng +/- 5 um quanh tâm
    idx_roi  = abs(x_um) <= x_roi_um;
    
    x_cut = x_um(idx_roi);
    profile_true = am(mid_y, idx_roi);
    profile_rec  = amp_rec(mid_y, idx_roi);
    
    rmse_roi = sqrt(mean((profile_true - profile_rec).^2));
    fprintf('Profile RMSE (ROI): %.4f\n', rmse_roi);
    
    % Lưu thông số vào mảng tổng kết
    summary_data(k, :) = [FOV_list_um(k), N, z_max*1e3, z_crit*1e6, ...
                          NA_eff_z1, NA_eff_z2, R_z1*1e9, R_z2*1e9, rmse_roi];
    
    % --- Vẽ biểu đồ kèm hộp chú thích thông số trực tiếp ---
    figure(fig_compare);
    subplot(2, 2, k);
    stairs(x_cut, profile_true, 'Color', '#0072BD', 'LineWidth', 1.8);
    hold on;
    plot(x_cut, profile_rec, 'Color', '#D95319', 'LineWidth', 1.8, 'LineStyle', '--');
    grid on; grid minor;
    xlim([-x_roi_um, x_roi_um]);
    ylim([-0.15, 1.35]);
    xlabel('x (\mum)');
    ylabel('Amplitude (a.u.)');
    legend('Ground Truth', 'Reconstruction', 'Location', 'southeast');
    title(sprintf('FOV = %d \\mum (%dx%d px) | %s', FOV_list_um(k), N, N, regime_str));
    
    % Hộp thông số hiển thị ngay trên góc trái biểu đồ
    info_txt = {
        sprintf('NA_{z1} = %.4f | NA_{z2} = %.4f', NA_eff_z1, NA_eff_z2), ...
        sprintf('R_{z1} = %.1f nm | R_{z2} = %.1f nm', R_z1*1e9, R_z2*1e9), ...
        sprintf('z_{crit} = %.1f \\mum | RMSE = %.4f', z_crit*1e6, rmse_roi)
    };
    text(-x_roi_um + 0.3, 1.15, info_txt, 'FontSize', 8.5, ...
         'BackgroundColor', [0.97 0.97 0.97], 'EdgeColor', [0.7 0.7 0.7]);
    drawnow;
    
    % Giải phóng bộ nhớ
    clear X Y object u_object am prop_z1 prop_z2 field_z1_true field_z2_true ...
          prop_dz prop_minus_dz prop_minus_z1 u1 u2 u1_sim u2_sim u_obj_rec amp_rec;
end

%% 4. IN BẢNG TỔNG KẾT SO SÁNH TẤT CẢ CÁC FOV
fprintf('\n========================================================================================================\n');
fprintf('                                     SUMMARY TABLE ACROSS FOVs                                          \n');
fprintf('========================================================================================================\n');
fprintf('%-8s | %-10s | %-10s | %-10s | %-9s | %-9s | %-10s | %-10s | %-8s\n', ...
        'FOV(um)', 'Grid (N)', 'z_max(mm)', 'z_crit(um)', 'NA_z1', 'NA_z2', 'R_z1(nm)', 'R_z2(nm)', 'RMSE');
fprintf('--------------------------------------------------------------------------------------------------------\n');
for k = 1:num_FOV
    fprintf('%-8.0f | %-10.0f | %-10.2f | %-10.2f | %-9.5f | %-9.5f | %-10.2f | %-10.2f | %-8.4f\n', ...
            summary_data(k, 1), summary_data(k, 2), summary_data(k, 3), summary_data(k, 4), ...
            summary_data(k, 5), summary_data(k, 6), summary_data(k, 7), summary_data(k, 8), summary_data(k, 9));
end
fprintf('========================================================================================================\n');
toc

%% =========================================================================
%                                FUNCTIONS
% =========================================================================
function p = Propagator_BLASM(N, lambda, dx, z)
    df = 1 / (N * dx);
    f = (-N/2 : N/2 - 1) * df;
    [FX, FY] = meshgrid(f, f);

    alpha = lambda * FX;
    beta  = lambda * FY;

    limit = 1 / sqrt((2 * abs(z) / (N * dx))^2 + 1);
    mask = (alpha.^2 + beta.^2) <= limit^2;

    p = zeros(N, N);
    p(mask) = exp(1i * 2 * pi * (z / lambda) * ...
              sqrt(1 - alpha(mask).^2 - beta(mask).^2));
end

function out = FT2Dc(in)
    out = fftshift(fft2(ifftshift(in)));
end

function out = IFT2Dc(in)
    out = fftshift(ifft2(ifftshift(in)));
end